# Backend Environment Configuration
# Copy to .env and fill in values. Never commit the actual .env file.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_chatbot
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/english_chatbot

# LLM Provider (model ID is configuration, not code)
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT_MS=1500

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret

# Test Database (used by CI and local test runs)
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
